# F1 Dashboard Environment Variables

# Public URL where the app is served (used for SEO: canonical, sitemap, OG images).
# Must include protocol, no trailing slash. Falls back to https://f1.kabeza.fun.
NEXT_PUBLIC_SITE_URL=https://f1.kabeza.fun

# URL of the F1 proxy server (for SSE connection)
# In Docker: http://proxy:4000
# Local development: http://localhost:4000
# With Cloudflare Tunnel: https://f1-proxy.yourdomain.com
NEXT_PUBLIC_PROXY_URL=http://localhost:4000

# For docker-compose: Public URL of proxy (used by frontend in browser)
# If using Cloudflare Tunnel, set this to your public proxy URL
# Example: https://f1-proxy.yourdomain.com
PROXY_PUBLIC_URL=http://localhost:4000

# ── Auth (NextAuth v5 / Auth.js) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Comma-separated list of Google emails that get the "admin" role automatically
AUTH_ADMIN_EMAILS=you@gmail.com

# Directory for user profile JSON file (default: ./data/profiles.json)
# In Docker, mount a volume here for persistence.
# PROFILES_DIR=/app/data
